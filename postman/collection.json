{
  "info": {
    "name": "Exclusive Resorts inquiry API checks",
    "description": "Safe Postman/Newman templates for the observed inquiry submit contract. Requests remain skipped by default until an isolated target is explicitly approved.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('contractCaptured') !== 'true') {",
          "  console.warn('BLOCKED: collection disabled; no HTTP request was sent.');",
          "  pm.execution.skipRequest();",
          "} else {",
          "  try {",
          "    const expand = (text) => {",
          "      for (let i = 0; i < 5 && text.includes('{{'); i++) text = pm.variables.replaceIn(text);",
          "      if (/{{|}}/.test(text)) throw new Error('Unresolved variable in request');",
          "      return text;",
          "    };",
          "    const endpoint = expand(pm.request.url.toString());",
          "    const match = endpoint.match(/^(https?:\\/\\/[a-z0-9.-]+(?::[0-9]+)?)\\/submit-form\\/$/i);",
          "    const approvedOrigin = pm.environment.get('isolatedTargetOrigin');",
          "    if (!match || match[1] !== approvedOrigin) throw new Error('Set isolatedTargetOrigin to the exact approved isolated origin');",
          "    if (/^https?:\\/\\/public-site\\.stage\\.exclusiveresorts\\.com(?::[0-9]+)?$/i.test(match[1])) {",
          "      throw new Error('The captured shared stage target is blocked; use an isolated target');",
          "    }",
          "    const negative = pm.info.requestName.startsWith('Negative');",
          "    const statusKey = pm.request.method === 'GET' ? 'expectedMethodStatuses' : negative ? 'expectedValidationStatuses' : 'expectedSuccessStatuses';",
          "    const configured = pm.environment.get(statusKey) || '';",
          "    const statuses = configured.split(',').map((s) => Number(s.trim()));",
          "    if (!configured.trim() || statuses.some((s) => !Number.isInteger(s) || (negative ? s < 400 || s >= 500 : s < 200 || s >= 300))) {",
          "      throw new Error('Configure ' + statusKey + ' with ' + (negative ? '4xx rejection' : '2xx success') + ' statuses before sending');",
          "    }",
          "    pm.variables.set('assertionStatuses', JSON.stringify(statuses));",
          "    pm.request.url.update(endpoint);",
          "    if (pm.request.body && pm.request.body.mode === 'raw') {",
          "      const raw = expand(pm.request.body.raw);",
          "      const body = JSON.parse(raw);",
          "      if (body.form !== 'SHORT_FORM' || typeof body.values !== 'string') throw new Error('Expected SHORT_FORM JSON wrapper with encoded values');",
          "      pm.request.body.update(raw);",
          "    }",
          "  } catch (error) {",
          "    pm.test('request configuration is valid', () => { throw error; });",
          "    pm.execution.skipRequest();",
          "  }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "submitUrl",
      "value": "{{baseUrl}}/submit-form/",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Baseline — valid lead (blocked by default)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{baselinePayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{submitUrl}}",
        "description": "Observed body is a JSON wrapper whose values member contains a URL-encoded short-form string. Keep contact values synthetic and run only against an approved isolated target."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const statuses = JSON.parse(pm.variables.get('assertionStatuses'));",
              "pm.test('response status matches the configured contract', () => {",
              "  pm.expect(statuses).to.include(pm.response.code);",
              "});",
              "pm.test('success is JSON with a non-empty lead identifier', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type') || '').to.match(/application\\/json/i);",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.nested.property('data.id');",
              "  pm.expect(['string', 'number']).to.include(typeof body.data.id);",
              "  pm.expect(String(body.data.id).trim()).not.to.equal('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Negative — missing required field",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{contentType}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{missingRequiredPayload}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{submitUrl}}",
        "description": "Remove one required key from the captured baseline payload. Configure expectedValidationStatuses only after observing the isolated contract."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const statuses = JSON.parse(pm.variables.get('assertionStatuses'));",
              "pm.test('response status matches the configured contract', () => {",
              "  pm.expect(statuses).to.include(pm.response.code);",
              "});",
              "pm.test('invalid request is rejected without a lead identifier', () => {",
              "  pm.expect(pm.response.code).to.be.within(400, 499);",
              "  if (/json/i.test(pm.response.headers.get('Content-Type') || '')) {",
              "    pm.expect(pm.response.json()).not.to.have.nested.property('data.id');",
              "  }",
              "});"
            ]
          }
        }
      ]
    },
